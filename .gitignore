# Any build directory, by whatever suffix this tree names it: builddir itself, a
# second one used as a staging install, or a builddir2 left
# next to it. A 1.5 GB installed CEF runtime is not what git wants to be asked
# about, and `builddir-*/` alone missed every name without the dash.
builddir*/
build-pkg-deb/
build-pkg-rpm/
pkg-deb/
pkg-rpm/
deb-libcefnest0/
deb-libcefnest-dev/
deb-cefnest-demo/
deb-cefnest-helper/
deb-cefnest/
deb-cefnest-dev/
rpmbuild/
dist/
/artifact/
/cefnest-build.tar.gz
/RELEASE-NOTES.md
helper/build/
compile_commands.json
*.o
*.a
*.so
*.png
*.log
.ninja_deps
.ninja_log
third_party/
/cef_binary_*.tar.bz2
/gtk4-*
test/__pycache__/
