{
  "rewrites": [
    {
      "source": "/assets/*",
      "destination": "/assets/:splat"
    },
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "caches": [
    {
      "source": "/*",
      "cacheTtl": 0
    }
  ]
}
